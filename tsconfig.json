{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "types": ["node", "svelte"]
  },
  "include": ["src/**/*.ts", "src/**/*.svelte", "tools/architecture/**/*.ts", "vite.config.ts"]
}
