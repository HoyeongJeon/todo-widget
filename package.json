{
  "name": "todo-widget",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "tauri": "tauri",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.tools.json && tsc --noEmit -p tsconfig.core.json && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "spec:check": "node tools/spec-check/cli.ts",
    "spec:check:strict": "node tools/spec-check/cli.ts --strict",
    "privacy:check": "node tools/privacy/cli.ts"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tauri-apps/cli": "2.12.1",
    "@testing-library/svelte": "5.4.2",
    "@types/node": "^26.6.4",
    "happy-dom": "20.14.5",
    "svelte": "5.57.1",
    "svelte-check": "4.7.6",
    "typescript": "~5.9.3",
    "vite": "8.3.2",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.1",
    "@tauri-apps/plugin-process": "2.4.0",
    "@tauri-apps/plugin-updater": "2.13.1"
  }
}
